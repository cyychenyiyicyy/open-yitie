{
  "name": "open-yitie",
  "productName": "Open作业贴",
  "version": "1.0.0",
  "description": "Open作业贴 —— 教室大屏作业看板（开源离线版）",
  "main": "main.js",
  "author": {
    "name": "yiyi",
    "email": "yiyi@users.noreply.github.com"
  },
  "homepage": "https://github.com/cyychenyiyicyy/open-yitie",
  "license": "MIT",
  "scripts": {
    "start": "electron ."
  },
  "build": {
    "appId": "com.yiyi.openuitie",
    "productName": "Open作业贴",
    "copyright": "Copyright © 2026 yiyi",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "store.js",
      "mini.js",
      "preload.js",
      "mini-preload.js",
      "mini.html",
      "page/**/*",
      "assets/icon.png",
      "assets/tray.png",
      "assets/tray22.png",
      "assets/tray32.png",
      "assets/tray64.png"
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "icon": "assets/icon.png",
      "maintainer": "yiyi <yiyi@users.noreply.github.com>",
      "synopsis": "教室大屏作业看板（开源离线版）",
      "description": "Open作业贴 —— 给教室大屏用的每日作业看板。支持九科作业录入、提交时效高亮、导学案课时、展示模式、卡片自定义背景；**完全离线运行**，数据只存在本机，不联网、不上传、不含 AI 与语音功能。MIT 开源。",
      "desktop": {
        "entry": {
          "Name": "Open作业贴",
          "Comment": "教室大屏作业看板（开源离线版）",
          "Categories": "Education;Office;",
          "StartupWMClass": "open-yitie"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libnspr4",
        "libatk1.0-0",
        "libatk-bridge2.0-0",
        "libatspi2.0-0",
        "libcups2",
        "libdrm2",
        "libgbm1",
        "libasound2",
        "libpango-1.0-0",
        "libcairo2",
        "libxkbcommon0",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxrandr2",
        "libx11-6",
        "libxext6",
        "libxrender1",
        "libxi6",
        "libxtst6",
        "libuuid1",
        "libexpat1",
        "libdbus-1-3",
        "libglib2.0-0",
        "xdg-utils"
      ]
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyychenyiyicyy/open-yitie.git"
  }
}
